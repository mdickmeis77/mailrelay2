@page
@model Vemas.MailRelay.Pages.Customers.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neuer Kunde" : $"Kunde {Model.Input.Name}";
}

<p><a href="/Customers">‹ Kunden</a></p>
<h1>@ViewData["Title"]</h1>

<form method="post" class="panel">
    <input type="hidden" asp-for="Input.CustomerId" />
    <div asp-validation-summary="ModelOnly" class="error-text"></div>

    <div class="grid2">
        <div class="field">
            <label asp-for="Input.Name">Name</label>
            <input type="text" asp-for="Input.Name" />
            <span asp-validation-for="Input.Name" class="error-text"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ShortName">Kurzname (erscheint im Verlauf, z.B. „Neu gesendet von MMU (KUNDE)“)</label>
            <input type="text" asp-for="Input.ShortName" />
            <span asp-validation-for="Input.ShortName" class="error-text"></span>
        </div>
        <div class="field">
            <label><input type="checkbox" asp-for="Input.IsActive" /> Kunde aktiv (gesperrte Kunden sehen in NextGen keine Daten)</label>
        </div>
    </div>

    <div class="field">
        <label asp-for="Input.Logins">SQL-Server-Logins der NextGen-Instanz – einer pro Zeile</label>
        <textarea asp-for="Input.Logins"></textarea>
        <span asp-validation-for="Input.Logins" class="error-text"></span>
        <span class="hint">Der Login, mit dem NextGen auf seine Datenbank zugreift: ein Windows-Konto (DOMAENE\svc-nextgen-kunde),
            die App-Pool-Identität (IIS APPPOOL\NextGen bzw. DOMAENE\WEBSERVER$), eine Windows-Gruppe oder ein SQL-Login (vemas).
            Datenbank-Benutzer, Rechte und Synonyme richtet Add-Customer.sql ein.</span>
    </div>

    <div class="actions">
        <button type="submit" class="primary">Speichern</button>
        <a class="button" href="/Customers">Abbrechen</a>
    </div>
</form>

@if (!Model.IsNew)
{
    <p class="muted">Profile ordnest du dem Kunden auf der jeweiligen Profilseite zu. SMTP-Benutzer gehören automatisch zum Kunden ihres Profils.</p>
}
