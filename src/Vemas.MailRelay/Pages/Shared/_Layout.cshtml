<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Vemas.MailRelay</title>
    @* Styles inline, damit die Single-File-EXE keine wwwroot-Dateien braucht *@
    <style>
        :root {
            --bg: #f5f6f8; --panel: #fff; --text: #1d2330; --muted: #6b7280; --line: #e3e6eb;
            --accent: #1f5fa8; --accent-text: #fff;
            --ok-bg: #e5f5ea; --ok: #1b7a3a; --err-bg: #fde8e8; --err: #b42318;
            --warn-bg: #fff4e0; --warn: #a15c00; --info-bg: #e8f0fb; --info: #1f5fa8;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #14171c; --panel: #1d2128; --text: #e6e8eb; --muted: #9aa1ab; --line: #2e333b;
                --accent: #5b9be0; --accent-text: #0e1116;
                --ok-bg: #173323; --ok: #6fd394; --err-bg: #3b1a1a; --err: #f28b82;
                --warn-bg: #3a2c12; --warn: #f2c06b; --info-bg: #182a40; --info: #8cb8ec;
            }
        }
        * { box-sizing: border-box; }
        body { margin: 0; font: 14px/1.5 "Segoe UI", system-ui, sans-serif; background: var(--bg); color: var(--text); }
        header { background: var(--panel); border-bottom: 1px solid var(--line); }
        .bar { max-width: 1400px; margin: 0 auto; padding: 0 16px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; min-height: 52px; }
        .brand { font-weight: 600; font-size: 16px; }
        nav { display: flex; gap: 4px; flex-wrap: wrap; }
        nav a { color: var(--text); text-decoration: none; padding: 6px 12px; border-radius: 6px; }
        nav a:hover { background: var(--bg); }
        .user { margin-left: auto; color: var(--muted); font-size: 13px; }
        main { max-width: 1400px; margin: 0 auto; padding: 20px 16px 48px; }
        h1 { font-size: 20px; margin: 0 0 16px; }
        h2 { font-size: 16px; margin: 24px 0 8px; }
        a { color: var(--accent); }
        .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px; margin-bottom: 16px; }
        .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 16px; }
        .tile { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
        .tile .value { font-size: 28px; font-weight: 600; }
        .tile .label { color: var(--muted); font-size: 13px; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; background: var(--panel); }
        th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
        th { font-weight: 600; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
        tr:hover td { background: color-mix(in srgb, var(--bg) 60%, transparent); }
        .badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; font-weight: 600; white-space: nowrap; }
        .ok { background: var(--ok-bg); color: var(--ok); }
        .err { background: var(--err-bg); color: var(--err); }
        .warn { background: var(--warn-bg); color: var(--warn); }
        .info { background: var(--info-bg); color: var(--info); }
        .muted { color: var(--muted); }
        .badge.muted { background: var(--bg); }
        .alert { padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; }
        form.inline { display: inline; }
        .filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: end; }
        .field { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
        .field label { font-size: 13px; color: var(--muted); }
        .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0 16px; }
        input[type=text], input[type=password], input[type=date], input[type=email], select, textarea {
            font: inherit; color: var(--text); background: var(--panel); border: 1px solid var(--line);
            border-radius: 6px; padding: 6px 8px; width: 100%;
        }
        textarea { min-height: 80px; font-family: Consolas, monospace; }
        .filters input, .filters select { width: auto; }
        button, .button {
            font: inherit; border: 1px solid var(--line); background: var(--panel); color: var(--text);
            padding: 6px 14px; border-radius: 6px; cursor: pointer; text-decoration: none; display: inline-block;
        }
        button.primary, .button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
        .actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
        .hint { font-size: 12px; color: var(--muted); }
        .error-text { color: var(--err); font-size: 13px; }
        .mono { font-family: Consolas, monospace; font-size: 13px; word-break: break-all; }
        dl.props { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
        dl.props dt { color: var(--muted); }
        dl.props dd { margin: 0; word-break: break-word; }
        .pager { display: flex; gap: 8px; align-items: center; margin-top: 12px; }
    </style>
</head>
<body>
    <header>
        <div class="bar">
            <span class="brand">Vemas.MailRelay</span>
            <nav>
                <a href="/">Dashboard</a>
                <a href="/Messages">Protokoll</a>
                <a href="/Profiles">Profile</a>
                <a href="/Users">SMTP-Benutzer</a>
                <a href="/Customers">Kunden</a>
            </nav>
            <span class="user">@User.Identity?.Name</span>
        </div>
    </header>
    <main>
        @if (TempData["Message"] is string message)
        {
            <div class="alert ok">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert err">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>
