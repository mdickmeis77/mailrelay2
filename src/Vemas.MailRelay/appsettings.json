{
  "ConnectionStrings": {
    "MailRelay": "Server=SQLSERVER;Database=NextGen;Integrated Security=true;TrustServerCertificate=true;Application Name=Vemas.MailRelay"
  },
  "Smtp": {
    "Port": 587,
    "ServerName": "Vemas.MailRelay",
    "MaxMessageSizeMb": 150,
    "CertificateThumbprint": "",
    "RequireTls": false
  },
  "Web": {
    "Port": 8587,
    "AdminGroup": "DOMAENE\\MailRelay-Admins",
    "CertificateThumbprint": ""
  },
  "Sending": {
    "RetryDelaysMinutes": [ 1, 5, 15, 60, 240 ],
    "MaxParallel": 4,
    "PollIntervalSeconds": 10
  },
  "DatabaseMail": {
    "Enabled": true,
    "ConnectionString": ""
  },
  "Maintenance": {
    "MimeRetentionDays": 30,
    "LogRetentionDays": 365,
    "SecretExpiryWarningDays": 30,
    "ConfigRefreshSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "Vemas.MailRelay": "Information"
      }
    }
  }
}
